{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/metodo", "destination": "/metodo/index.html" },
    { "source": "/industria", "destination": "/industria/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
